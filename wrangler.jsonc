// Cloudflare Workers config for reconms.com.
// Pages are served straight from the prerendered ./dist folder; only /api/* runs Worker code
// (worker/index.ts), which powers the contact form.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reconms-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only API requests (and robots.txt and the internal scheduled-posts file, see
    // worker/index.ts) run the Worker; everything else is served straight from the static files.
    "run_worker_first": ["/api/*", "/robots.txt", "/scheduled-posts.json"],
    // Pages live at /about/ (matching the old WordPress URLs); /about redirects to /about/.
    "html_handling": "force-trailing-slash",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  "vars": {
    // Contact-form delivery. The sender's domain (reconms.com) is verified in Resend.
    "CONTACT_TO": "hello@reconms.com",
    "CONTACT_FROM": "Recon Website <website@reconms.com>"
  },
  // Daily at 12:07 UTC (6:07 AM CST / 7:07 AM CDT): rebuild the site if a scheduled blog post's
  // publish date has arrived (worker/schedule.ts).
  "triggers": {
    "crons": ["7 12 * * *"]
  },
  "observability": {
    "enabled": true
  }
  // Secrets (set in the Cloudflare dashboard or with `npx wrangler secret put <NAME>`):
  //   TURNSTILE_SITE_KEY    Turnstile widget site key (public; a plain-text variable is fine)
  //   TURNSTILE_SECRET_KEY  Cloudflare Turnstile widget secret key
  //   RESEND_API_KEY        Resend API key with "sending access"
  //   DEPLOY_HOOK_URL       Workers Builds deploy hook for the production branch (publishes
  //                         scheduled blog posts; see README)
}
