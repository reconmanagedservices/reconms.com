# Permanent redirects from the old WordPress site to the closest new page.
# Format: <old path> <new path or URL> <status>. Top-most match wins.
# Pages that kept their URL (/, /about/, /contact/, /terms/, /privacy-policy/, /managed/,
# /comanaged/, /ai/) need no rule.

# Old service pages. /managed/, /comanaged/ and /ai/ are live pages again (src/servicePages.ts).
/other              /products/                    301
/other/             /products/                    301
/interest-form      /contact/                     301
/interest-form/     /contact/                     301
/customer-portal    https://portal.reconms.com    301
/customer-portal/   https://portal.reconms.com    301

# Old WordPress blog feed, category and author archives
/feed               /news/feed.xml                301
/feed/              /news/feed.xml                301
/news/feed          /news/feed.xml                301
/news/feed/         /news/feed.xml                301
/category/*         /news/                        301
/author/*           /news/                        301

# Old WordPress / Yoast sitemap URLs (may still be registered in Google Search Console)
/sitemaps.xml           /sitemap.xml    301
/sitemap_index.xml      /sitemap.xml    301
/wp-sitemap.xml         /sitemap.xml    301
/page-sitemap.xml       /sitemap.xml    301
/page-sitemap1.xml      /sitemap.xml    301
/post-sitemap1.xml      /sitemap.xml    301
/category-sitemap1.xml  /sitemap.xml    301
